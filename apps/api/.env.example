# Template only — put actual secrets in your host's encrypted secret manager.
APP_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/almuallim
REDIS_URL=redis://localhost:6379/0
PUBLIC_WEB_ORIGIN=https://app.example.invalid
CORS_ALLOWED_ORIGINS=https://app.example.invalid

# Must be your verified OIDC issuer, audience, and HTTPS JWKS endpoint.
OIDC_ISSUER=https://auth.example.invalid/
OIDC_AUDIENCE=almuallim-api
OIDC_JWKS_URL=https://auth.example.invalid/.well-known/jwks.json

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_GIFT_YEAR_GBP_PRICE_ID=

# Native RevenueCat HMAC webhook signing (enable HMAC in RevenueCat dashboard).
REVENUECAT_WEBHOOK_SIGNING_SECRET=
REVENUECAT_WEBHOOK_AUTHORIZATION=
REVENUECAT_SECRET_API_KEY=

# Model API for the separate verse generator; no frontend exposure.
GEMINI_API_KEY=
GEMINI_MODEL=

# No advertising keys or tracking SDK configuration anywhere.
